# For the root docker-compose.yml only. Copy to .env and adjust. Never commit .env.

# Optional: OpenRouter key for AI drafts. Leave empty to use template messages only.
AI_API_KEY=

# AI limits. A thinking model needs room: its thinking counts toward the output tokens.
AI_MAX_OUTPUT_TOKENS=8000
# off | low | medium | high (none = do not send the setting)
AI_REASONING_EFFORT=medium
AI_TIMEOUT_MS=60000
# How many top alerts the AI briefing looks at (every alert still gets an AI message)
AI_TOP_N=5

# MySQL root password inside Docker
MYSQL_PASSWORD=root

# Ports on your computer (change them if they are busy; run docker compose up --build after a change)
WEB_PORT=3000
API_PORT=4000
MYSQL_HOST_PORT=3306
PMA_PORT=8080
