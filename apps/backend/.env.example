# Copy to .env and adjust. Never commit .env.
# docker compose reads this file for the ${VAR:-default} values in docker-compose.yml.

# API
APPLICATION_SERVER_PORT=4000
APP_FORCE_SHUTDOWN_SECOND=30

# MySQL (local development only)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=stallalert
MYSQL_USER=stallalert
MYSQL_PASSWORD=stallalert
MYSQL_ROOT_PASSWORD=root
