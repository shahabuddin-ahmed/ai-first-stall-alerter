# Copy to .env and adjust. Never commit .env.
# docker compose reads this file for the ${VAR:-default} values in docker-compose.yml.

# API
NODE_ENV=development
APPLICATION_SERVER_PORT=4000
APP_FORCE_SHUTDOWN_SECOND=30
# Browsers may call the API only from these origins (comma-separated): the Next.js app
WEB_ORIGIN=http://localhost:3000
# Per IP address, per minute
RATE_LIMIT_UPLOADS_PER_MINUTE=20
RATE_LIMIT_INSIGHTS_PER_MINUTE=10

# MySQL (local development only)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=stallalert
# Used by the tests only (yarn test-integ). yarn db:migrate and the tests create the databases if missing.
MYSQL_TEST_DATABASE=stallalert_test
MYSQL_USER=root
MYSQL_PASSWORD=root

# AI drafts (optional). Leave empty to use template messages only. Never commit a real key.
# The model is chosen in the app settings.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_TOP_N=5
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=1500
# Thinking models: off (fastest) | low | medium | high; none = do not send the setting
AI_REASONING_EFFORT=low
