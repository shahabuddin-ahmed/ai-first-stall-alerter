# Copy to .env and adjust. Never commit .env.
# docker compose reads this file for the ${VAR:-default} values in docker-compose.yml.

# API
NODE_ENV=development
APPLICATION_SERVER_PORT=4000
APP_FORCE_SHUTDOWN_SECOND=30

# MySQL (local development only)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=stallalert
# Used by the tests only (yarn test-integ); created by docker/mysql-init
MYSQL_TEST_DATABASE=stallalert_test
MYSQL_USER=stallalert
MYSQL_PASSWORD=stallalert
MYSQL_ROOT_PASSWORD=root

# AI drafts (optional). Leave empty to use template messages only. Never commit a real key.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_TOP_N=5
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=1500
# live = call the provider; fake = built-in stand-in, no network (tests and demos)
AI_MODE=live
# Thinking models: off (fastest) | low | medium | high; none = do not send the setting
AI_REASONING_EFFORT=low
